#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

target_dir=$(cargo metadata --no-deps --format-version=1 | jq -er .target_directory)
output="$target_dir/foxfire-web"
cargo build --locked --release -p foxfire-web --target wasm32-unknown-unknown
mkdir -p "$output"
wasm-bindgen --target web --out-dir "$output" "$target_dir/wasm32-unknown-unknown/release/foxfire_web.wasm"
cp crates/foxfire-web/static/index.html "$output/index.html"
cp assets/app-icon.png "$output/app-icon.png"
printf 'Serve the browser client with:\n  miniserve --interfaces 127.0.0.1 --port 8000 --index index.html %q\n' "$output"
