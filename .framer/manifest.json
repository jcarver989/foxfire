{
  "files": {
    ".cargo/config.toml": {
      "kind": "toml",
      "keys": [
        "alias.rouge"
      ]
    },
    ".config/nextest.toml": {
      "kind": "managed"
    },
    ".github/dependabot.yml": {
      "kind": "managed"
    },
    ".github/workflows/ci.yml": {
      "kind": "managed"
    },
    ".github/workflows/release-plz.yml": {
      "kind": "managed"
    },
    ".github/workflows/rouge-publish.yml": {
      "kind": "managed"
    },
    ".gitignore": {
      "kind": "blocks",
      "ids": [
        "framer",
        "rouge/publishing",
        "rust-monorepo"
      ]
    },
    ".tool-versions": {
      "kind": "managed"
    },
    "AGENTS.md": {
      "kind": "blocks",
      "ids": [
        "rust-monorepo/conventions"
      ]
    },
    "Cargo.toml": {
      "kind": "toml",
      "keys": [
        "workspace.resolver",
        "workspace.members",
        "workspace.package.edition",
        "workspace.package.license",
        "workspace.package.repository",
        "workspace.package.rust-version",
        "workspace.lints",
        "profile.dev",
        "profile.dist"
      ]
    },
    "android/build.gradle": {
      "kind": "managed"
    },
    "android/gradle/wrapper/gradle-wrapper.properties": {
      "kind": "managed"
    },
    "android/proguard-rules.pro": {
      "kind": "managed"
    },
    "android/settings.gradle": {
      "kind": "managed"
    },
    "android/src/main/AndroidManifest.xml": {
      "kind": "managed"
    },
    "android/src/main/java/dev/foxfire/app/RougeActivity.java": {
      "kind": "managed"
    },
    "android/src/main/java/rouge/webview/WebPage.java": {
      "kind": "managed"
    },
    "clippy.toml": {
      "kind": "managed"
    },
    "dist-workspace.toml": {
      "kind": "managed"
    },
    "ios/Assets.xcassets/AppIcon.appiconset/Contents.json": {
      "kind": "managed"
    },
    "ios/Assets.xcassets/Contents.json": {
      "kind": "managed"
    },
    "ios/Info.plist": {
      "kind": "managed"
    },
    "ios/PrivacyInfo.xcprivacy": {
      "kind": "managed"
    },
    "ios/RougeApp.xcodeproj/project.pbxproj": {
      "kind": "managed"
    },
    "ios/RougeApp.xcodeproj/xcshareddata/xcschemes/RougeApp.xcscheme": {
      "kind": "managed"
    },
    "ios/cargo.sh": {
      "kind": "managed"
    },
    "justfile": {
      "kind": "blocks",
      "ids": [
        "rust-monorepo"
      ]
    },
    "mise.toml": {
      "kind": "toml",
      "keys": [
        "tasks.ios-sim"
      ]
    },
    "release-plz.toml": {
      "kind": "toml",
      "keys": [
        "workspace.release_always",
        "workspace.git_release_enable",
        "workspace.git_tag_name",
        "workspace.pr_branch_prefix",
        "workspace.pr_name",
        "workspace.dependencies_update",
        "workspace.release",
        "workspace.publish",
        "workspace.semver_check"
      ]
    },
    "rust-toolchain.toml": {
      "kind": "managed"
    },
    "rustfmt.toml": {
      "kind": "managed"
    }
  }
}
